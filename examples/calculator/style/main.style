OuterContainer {
    padding: 16;

    display: flex;
    flex-direction: column;
    gap: 4;
    border-radius: 5;

    background-color: #383838;
}

#line-editor {
    padding: 4;
    border-color: #282828;
}

.btn {
    width: 35;
    height: 25;
    border-color: #282828;
}

.btn-danger {
    border-color: #5e0c04;
    background-color: #c91808;
}

.btn-secondary {
    border-color: #033360;
    background-color: #0875db;
}

#equals-btn {
    width: unset; /* Stop from it using fixed sizing */
    height: unset; /* Stop from it using fixed sizing */
}
